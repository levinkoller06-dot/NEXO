# Kopiere diese Datei zu ".env" (im selben Ordner) und trage deine echten Keys ein.
# Diese Datei mit echten Werten wird NIE committet (siehe .gitignore).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Sprachausgabe (/api/speech) läuft über denselben Gemini-Key, kein separater Key nötig.
GEMINI_TTS_VOICE=Charon
PORT=4790
